// greet, quartzinfo and whois: reading things off the server and its players.
package org.quartzlang.examples.paper.scripts

import org.quartzlang.examples.paper.*

internal fn greet(sender: Sender, args: [str]) {
    let who = if args.len() > 0 {
        plain(args[0])
    } else {
        sender.name()
    }
    sender.send("<green>Hello, <white>{who}</white>!")
}

internal fn info(sender: Sender) {
    let lines = [
        "<gray>Runtime: <white>Quartz, sandboxed, {memoryUsed() / 1024} KiB in use",
        "<gray>Plugin: <white>QuartzExample {pluginVersion()}",
        "<gray>Server: <white>{serverName()}, Minecraft {minecraftVersion()}",
        "<gray>Players: <white>{onlinePlayers().len()}/{maxPlayers()}",
        "<gray>Worlds: <white>{worldNames().join(", ")}",
    ]
    for line in lines {
        sender.send(line)
    }
}

internal fn whois(sender: Sender, args: [str]) {
    let name = if args.len() > 0 {
        args[0]
    } else {
        sender.name()
    }
    if let p = findPlayer(name) {
        describe(sender, p)
    } else {
        sender.send("<red>No player called <white>{plain(name)}</white> is online.")
    }
}

fn describe(sender: Sender, p: Player) {
    let lines = [
        "<gray>Name: <white>{p.name()}",
        "<gray>UUID: <white>{p.uuid()}",
        "<gray>World: <white>{p.world()}",
        "<gray>At: <white>{p.x().floor() as int} {p.y().floor() as int} {p.z().floor() as int}",
        "<gray>Mode: <white>{p.gameMode()}",
        "<gray>Health: <white>{p.health():.0}/{p.maxHealth():.0}",
        "<gray>Food: <white>{p.food()}",
        "<gray>Level: <white>{p.level()}",
        "<gray>Ping: <white>{p.ping()}ms",
    ]
    for line in lines {
        sender.send(line)
    }
}
