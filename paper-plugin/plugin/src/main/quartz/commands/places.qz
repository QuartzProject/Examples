// sethome, home, delhome, setwarp, warp and delwarp: places kept in Quartz states, saved across restarts.
package org.quartzlang.examples.paper.scripts

import org.quartzlang.examples.paper.*

internal fn setHome(homes: Homes, sender: Sender) {
    if let p = requirePlayer(sender, "have a home") {
        homes.byPlayer[p.uuid()] = here(p)
        p.send("<green>Home set.")
    }
}

internal fn home(homes: Homes, sender: Sender) {
    if let p = requirePlayer(sender, "go home") {
        if let spot = homes.byPlayer.get(p.uuid()) {
            if travel(p, spot) {
                p.send("<green>Welcome home.")
            } else {
                p.send("<red>Your home was in <white>{spot.world}</white>, which is gone.")
            }
        } else {
            p.send("<red>You have no home yet. Use <white>/sethome</white>.")
        }
    }
}

internal fn delHome(homes: Homes, sender: Sender) {
    if let p = requirePlayer(sender, "forget a home") {
        if homes.byPlayer.has(p.uuid()) {
            homes.byPlayer.remove(p.uuid())
            p.send("<gray>Home forgotten.")
        } else {
            p.send("<red>You have no home to forget.")
        }
    }
}

internal fn setWarp(warps: Warps, sender: Sender, args: [str]) {
    if !allowed(sender, "quartzexample.setwarp") {
        return
    }
    if args.len() != 1 {
        sender.send("<red>Usage: /setwarp <name>, standing where it should lead.")
        return
    }
    if let p = requirePlayer(sender, "set a warp") {
        let name = args[0].lower()
        warps.byName[name] = here(p)
        p.send("<green>Warp <white>{plain(name)}</white> saved.")
    }
}

internal fn warp(warps: Warps, sender: Sender, args: [str]) {
    if args.len() == 0 {
        if warps.byName.len() == 0 {
            sender.send("<red>No warps have been set.")
        } else {
            sender.send("<gray>Warps: <white>{warps.byName.keys().join(", ")}")
        }
        return
    }
    let name = args[0].lower()
    if let spot = warps.byName.get(name) {
        if let p = requirePlayer(sender, "warp") {
            if travel(p, spot) {
                p.send("<green>Warped to <white>{plain(name)}")
            } else {
                p.send("<red>That warp leads to <white>{spot.world}</white>, which is gone.")
            }
        }
    } else {
        sender.send("<red>No warp called <white>{plain(name)}")
    }
}

internal fn delWarp(warps: Warps, sender: Sender, args: [str]) {
    if !allowed(sender, "quartzexample.setwarp") {
        return
    }
    if args.len() != 1 || !warps.byName.has(args[0].lower()) {
        sender.send("<red>Usage: /delwarp <existing warp>")
        return
    }
    warps.byName.remove(args[0].lower())
    sender.send("<gray>Warp <white>{plain(args[0].lower())}</white> removed.")
}
