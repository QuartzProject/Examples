// heal: a permission for the command, and acting on somebody other than the caller.
package org.quartzlang.examples.paper.scripts

import org.quartzlang.examples.paper.*

@command("heal", description = "Fills the health and hunger of a player", permission = "quartzexample.heal",
    suggest = suggestPlayers)
fn heal(sender: Sender, args: [str]) {
    let target = if args.len() > 0 {
        playerNamed(args[0])
    } else {
        sender.player()
    }
    if let p = target {
        p.heal()
        p.send("<green>You have been healed.")
        if p.name != sender.name {
            sender.send("<gray>Healed <white>{p.name}")
        }
    } else if args.len() > 0 {
        sender.send("<red>No player called <white>{plain(args[0])}</white> is online.")
    } else {
        sender.send("<red>Usage from the console: /heal <player>")
    }
}
