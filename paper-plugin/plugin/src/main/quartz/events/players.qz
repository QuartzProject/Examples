// Join and quit messages, the first visit, and block protection. The host registers each @on with Paper.
package org.quartzlang.examples.paper.scripts

import org.quartzlang.examples.paper.*

/// Greets a player and returns the join message everybody sees.
@on(PlayerJoin)
fn welcome(player: Player) -> str {
    player.send("<gold>Welcome, {player.name}!")
    player.send("<gray>Everything you just read came from a Quartz script.")
    if !player.hasPlayedBefore() {
        player.toSpawn()
        player.playSound("entity.player.levelup")
        player.actionBar("<gold>Welcome to the server")
        broadcast("<yellow>{player.name} <gray>is here for the first time")
    }
    log("{player.name} joined, greeted from Quartz")
    return "<green>+ <white>{player.name}"
}

@on(PlayerQuit)
fn farewell(player: Player) -> str {
    return "<red>- <white>{player.name}"
}

/// Whether the player may break the block; the host asks only for the protected ones, which `where` names.
@on(BlockBreak, where = event.block == "bedrock" || event.block == "end_portal_frame" || event.block == "spawner")
fn guardBreak(event: BlockEvent) -> bool {
    if event.player.hasPermission("quartzexample.protected") {
        return true
    }
    event.player.send("<red>That block is protected.")
    return false
}

@on(BlockPlace, where = event.block == "tnt")
fn guardTnt(event: BlockEvent) -> bool {
    if event.player.hasPermission("quartzexample.tnt") {
        return true
    }
    event.player.send("<red>No TNT here.")
    return false
}
