// Value semantics: structs and fixed-size arrays copy on assignment, `with` makes changed copies, `const` folds.
package org.quartzlang.examples.values

const Size = 3
const Cells = Size * Size

@derive(Eq, Show)
enum Mark {
    Empty
    X
    O
}

struct Board {
    cells: [Mark; Cells]
    moves: int = 0
}

@derive(Show)
struct Settings {
    name: str
    volume: float = 0.8
    difficulty: int = 2
    subtitles: bool = false
}

const Lines: [[int; 3]; 8] = [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]]

impl Board {
    fn empty() -> Board {
        return Board([Mark.Empty; Cells])
    }

    fn play(self, cell: int, mark: Mark) -> Board? {
        if cell < 0 || cell >= Cells || self.cells[cell] != Mark.Empty {
            return null
        }
        var next = self.cells
        next[cell] = mark
        return Board(next, self.moves + 1)
    }

    fn winner(self) -> Mark {
        for line in Lines {
            let a = self.cells[line[0]]
            if a != Mark.Empty && a == self.cells[line[1]] && a == self.cells[line[2]] {
                return a
            }
        }
        return Mark.Empty
    }

    fn render(self) -> str {
        var rows: [str] = []
        for r in 0..Size {
            var row = ""
            for c in 0..Size {
                row += match self.cells[r * Size + c] {
                    Empty => "."
                    X => "X"
                    O => "O"
                }
            }
            rows.push(row)
        }
        return rows.join("\n")
    }
}

fn main() -> int {
    let defaults = Settings("player")
    let loud = defaults with { volume = 1.0 }
    let hard = loud with {
        difficulty = 3
        subtitles = true
    }
    print("{defaults}\n{loud}\n{hard}")

    var board = Board.empty()
    let before = board
    var turn = Mark.X
    for cell in [4, 0, 2, 4, 1, 6, 7] {
        if let next = board.play(cell, turn) {
            board = next
            turn = if turn == Mark.X {
                Mark.O
            } else {
                Mark.X
            }
        } else {
            print("cell {cell} is taken")
        }
        if board.winner() != Mark.Empty {
            break
        }
    }
    print(board.render())
    print("winner {board.winner()} after {board.moves} moves; the saved copy still has {before.moves} moves")

    var counts: [int; 3] = [0; 3]
    for m in board.cells {
        let slot = match m {
            Empty => 0
            X => 1
            O => 2
        }
        counts[slot] += 1
    }
    print("empty, X, O: {counts.toList()} (an array of {counts.len()})")
    return 0
}
